<odoo>
    <record id="module_category_edu_crm" model="ir.module.category">
        <field name="name">School CRM</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_edu_crm" model="res.groups.privilege">
        <field name="name">School CRM Role</field>
        <field name="category_id" ref="module_category_edu_crm"/>
    </record>

    <record id="group_edu_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="privilege_id" ref="privilege_edu_crm"/>
        <!-- Every school role implies Teacher, so granting the baseline Internal User
             group here (rather than on each role separately) gives everyone in the
             hierarchy the core read access every Odoo user needs (res.company,
             res.currency, etc.); the same baseline the "New User" wizard assigns
             automatically to any real internal user. -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_edu_frontdesk" model="res.groups">
        <field name="name">Front Desk / Admissions</field>
        <field name="privilege_id" ref="privilege_edu_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_edu_teacher'))]"/>
    </record>

    <record id="group_edu_principal" model="res.groups">
        <field name="name">Principal</field>
        <field name="privilege_id" ref="privilege_edu_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_edu_frontdesk'))]"/>
    </record>

    <record id="group_edu_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_edu_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_edu_frontdesk'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
