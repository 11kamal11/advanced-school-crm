    border-radius: 12px;
    background: #202b40;
    border: 1px solid #344056;
}

.edu-teacher-record strong {
    display: block;
    margin-bottom: 7px;
    font-size: 15px;
}

.edu-teacher-record small {
    color: #aeb8c8;
    font-size: 12px;
    line-height: 1.5;
}

/* =========================
   BENEFITS
   ========================= */

.edu-teacher-benefits {
    background: #ffffff;
