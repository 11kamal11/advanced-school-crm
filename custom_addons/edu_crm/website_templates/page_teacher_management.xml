/* =========================
   CTA
   ========================= */

.edu-teacher-cta {
    padding: 85px 0;
    text-align: center;
    background: linear-gradient(
        135deg,
        #eef5ff,
        #f8fbff
    );
}

.edu-teacher-cta h2 {
    font-size: 40px;
    margin: 0 0 15px;
    font-weight: 800;
}

.edu-teacher-cta p {
    max-width: 650px;
    margin: 0 auto 27px;
    color: #687282;
    font-size: 16px;
    line-height: 1.7;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 1100px) {

    .edu-teacher-hero-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .edu-teacher-feature-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-teacher-workflow-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .edu-teacher-benefit-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-teacher-records-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

@media (max-width: 700px) {

    .edu-teacher-container {
        width: 90%;
    }

    .edu-teacher-hero {
        padding: 65px 0;
    }

    .edu-teacher-hero h1 {
        font-size: 38px;
    }

    .edu-teacher-hero p {
        font-size: 16px;
    }

    .edu-teacher-btn,
    .edu-teacher-btn-light {
        display: block;
        width: 100%;
        text-align: center;
        margin: 0 0 12px;
    }

    .edu-teacher-btn-light {
        margin-left: 0;
    }

    .edu-teacher-feature-grid,
    .edu-teacher-dashboard-grid {
        grid-template-columns: 1fr;
    }

    .edu-teacher-workflow-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-teacher-benefit-grid {
        grid-template-columns: 1fr;
    }

    .edu-teacher-record-grid {
        grid-template-columns: 1fr;
    }

    .edu-teacher-details {
        grid-template-columns: 1fr;
    }

    .edu-teacher-heading h2,
    .edu-teacher-records-text h2,
    .edu-teacher-cta h2 {
        font-size: 30px;
    }

    .edu-teacher-section,
    .edu-teacher-records {
        padding: 65px 0;
    }
}
