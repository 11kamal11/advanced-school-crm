.edu-teacher-benefit {
    border: 1px solid #e1e7ef;
    border-radius: 14px;
    padding: 28px 22px;
}

.edu-teacher-benefit-number {
    color: #2864c7;
    font-size: 27px;
    font-weight: 800;
    margin-bottom: 13px;
}

.edu-teacher-benefit h3 {
    margin: 0 0 9px;
    font-size: 17px;
}

.edu-teacher-benefit p {
    margin: 0;
    color: #707988;
    font-size: 13px;
    line-height: 1.6;
