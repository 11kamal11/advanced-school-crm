    color: #687282;
    font-size: 18px;
    line-height: 1.7;
    margin: 0 0 30px;
}

.edu-teacher-btn {
    display: inline-block;
    padding: 15px 28px;
    border-radius: 8px;
    background: #2864c7;
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: 15px;
    font-weight: 700;
    transition: 0.25s;
}

.edu-teacher-btn:hover {
    background: #1e4f9f;
    transform: translateY(-2px);
}

.edu-teacher-btn-light {
    display: inline-block;
    padding: 14px 27px;
    margin-left: 8px;
    border-radius: 8px;
    border: 1px solid #d8e0ec;
    background: #ffffff;
    color: #172033 !important;
    text-decoration: none !important;
    font-size: 15px;
    font-weight: 700;
}

/* =========================
   TEACHER PROFILE VISUAL
   ========================= */

.edu-teacher-profile {
    background: #ffffff;
    border: 1px solid #e0e7f0;
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 20px 55px rgba(30,55,90,0.12);
}

.edu-teacher-profile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid #edf0f5;
}

.edu-teacher-profile-title {
    font-size: 17px;
    font-weight: 800;
}

.edu-teacher-status {
    background: #eaf7ef;
    color: #27834a;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
}

.edu-teacher-person {
    display: flex;
    align-items: center;
    gap: 17px;
    padding: 23px 0;
}

.edu-teacher-avatar {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: #e8f1ff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2864c7;
    font-size: 28px;
    font-weight: 800;
}

.edu-teacher-person h3 {
    margin: 0 0 5px;
    font-size: 19px;
}

.edu-teacher-person p {
    margin: 0;
    color: #747d8d;
    font-size: 13px;
}

.edu-teacher-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.edu-teacher-detail {
    padding: 15px;
    background: #f7f9fc;
    border-radius: 10px;
}

.edu-teacher-detail small {
    display: block;
    color: #7a8391;
    font-size: 11px;
    margin-bottom: 6px;
}

.edu-teacher-detail strong {
    font-size: 14px;
}

.edu-teacher-load {
    margin-top: 20px;
}

.edu-teacher-load-title {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 8px;
    color: #626c7b;
}

.edu-teacher-load-track {
    height: 9px;
    background: #e8edf4;
    border-radius: 10px;
    overflow: hidden;
}

.edu-teacher-load-fill {
    height: 100%;
    width: 72%;
    background: #2864c7;
    border-radius: 10px;
}

/* =========================
   SECTION
   ========================= */

.edu-teacher-section {
    padding: 90px 0;
}

.edu-teacher-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 50px;
}

.edu-teacher-heading span {
    color: #2864c7;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.edu-teacher-heading h2 {
    font-size: 40px;
    line-height: 1.2;
    margin: 12px 0 15px;
    font-weight: 800;
}

.edu-teacher-heading p {
    color: #687282;
    font-size: 16px;
    line-height: 1.7;
}

/* =========================
   FEATURE CARDS
   ========================= */

.edu-teacher-features {
    background: #ffffff;
}

.edu-teacher-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.edu-teacher-feature {
    padding: 30px;
    background: #f8fafc;
    border: 1px solid #e4e9f0;
    border-radius: 15px;
    transition: 0.25s;
}

.edu-teacher-feature:hover {
    transform: translateY(-5px);
    background: #ffffff;
    box-shadow: 0 14px 35px rgba(30,55,90,0.09);
}

.edu-teacher-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: #e8f1ff;
    color: #2864c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 19px;
}

.edu-teacher-feature h3 {
    margin: 0 0 9px;
    font-size: 19px;
}

.edu-teacher-feature p {
    margin: 0;
    color: #707988;
    font-size: 14px;
    line-height: 1.65;
}

/* =========================
   MANAGEMENT DASHBOARD
   ========================= */

.edu-teacher-dashboard {
    background: #f5f8fc;
}

.edu-teacher-dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.edu-teacher-dashboard-card {
    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 15px;
    padding: 27px;
}

.edu-teacher-dashboard-card h3 {
    margin: 0 0 20px;
    font-size: 18px;
}

.edu-teacher-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
}

.edu-teacher-stat {
    background: #f7f9fc;
    padding: 17px;
    border-radius: 10px;
}

.edu-teacher-stat small {
    color: #747d8d;
    display: block;
    font-size: 11px;
}

.edu-teacher-stat strong {
    display: block;
    margin-top: 6px;
    font-size: 25px;
}

/* TABLE */

.edu-teacher-table {
    width: 100%;
    border-collapse: collapse;
}

.edu-teacher-table th {
    text-align: left;
    font-size: 11px;
    color: #7a8391;
    padding: 10px 5px;
    border-bottom: 1px solid #e8edf3;
}

.edu-teacher-table td {
    padding: 12px 5px;
    font-size: 12px;
    border-bottom: 1px solid #edf0f4;
}

.edu-teacher-table td:last-child {
    color: #2864c7;
    font-weight: 700;
}

/* =========================
   WORKFLOW
   ========================= */

.edu-teacher-workflow {
    background: #ffffff;
}

.edu-teacher-workflow-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
