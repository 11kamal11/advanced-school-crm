    padding: 9px 17px;
    border-radius: 30px;
    background: #e8f1ff;
    color: #2864c7;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 20px;
}

.edu-teacher-hero h1 {
    font-size: 55px;
    line-height: 1.08;
    letter-spacing: -1.5px;
    margin: 0 0 22px;
