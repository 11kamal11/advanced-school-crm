            <div id="wrap" class="oe_structure">
                <style><![CDATA[
/* =========================
   ACADEMIC MANAGEMENT PAGE
   ========================= */

.edu-academic {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    padding: 0 !important;
    overflow: hidden;
    background: #ffffff;
    color: #172033;
    font-family: Arial, Helvetica, sans-serif;
}

.edu-academic * {
    box-sizing: border-box;
}

.edu-academic-container {
    width: 94%;
    max-width: 1450px;
    margin: 0 auto;
}

/* =========================
   HERO
   ========================= */

.edu-academic-hero {
    background:
        radial-gradient(circle at 85% 20%, rgba(40,100,199,0.16), transparent 30%),
        linear-gradient(135deg, #f5f9ff 0%, #ffffff 60%, #eef5ff 100%);
    padding: 95px 0 90px;
}

.edu-academic-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
}

.edu-academic-badge {
    display: inline-block;
    padding: 9px 17px;
    border-radius: 30px;
    background: #e8f1ff;
    color: #2864c7;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 22px;
}

.edu-academic-hero h1 {
    font-size: 56px;
    line-height: 1.08;
    margin: 0 0 24px;
    font-weight: 800;
    letter-spacing: -1.5px;
}

.edu-academic-hero h1 span {
    color: #2864c7;
}

.edu-academic-hero p {
    font-size: 19px;
    line-height: 1.7;
    color: #5f6878;
    max-width: 680px;
    margin: 0 0 32px;
}

.edu-academic-btn {
    display: inline-block;
    padding: 15px 28px;
    border-radius: 8px;
    background: #2864c7;
    color: #ffffff !important;
    text-decoration: none !important;
    font-weight: 700;
    font-size: 16px;
    margin-right: 10px;
    transition: 0.25s;
}

.edu-academic-btn:hover {
    background: #1e4f9f;
    transform: translateY(-2px);
}

.edu-academic-btn-light {
    display: inline-block;
    padding: 14px 27px;
    border-radius: 8px;
    border: 1px solid #d8e0ec;
    background: #ffffff;
    color: #172033 !important;
    text-decoration: none !important;
    font-weight: 700;
    font-size: 16px;
}

/* =========================
   ACADEMIC DASHBOARD CARD
   ========================= */

.edu-academic-dashboard {
    background: #ffffff;
    border: 1px solid #e0e7f0;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 20px 55px rgba(30,55,90,0.12);
}

.edu-academic-dashboard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid #edf0f5;
}

.edu-academic-dashboard-title {
    font-size: 18px;
    font-weight: 800;
}

.edu-academic-year {
    font-size: 12px;
    background: #edf5ff;
    color: #2864c7;
    padding: 7px 11px;
    border-radius: 6px;
    font-weight: 700;
}

.edu-academic-kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 20px;
}

.edu-academic-kpi {
    background: #f7f9fc;
    border-radius: 12px;
    padding: 17px;
}

.edu-academic-kpi small {
    color: #747d8d;
    font-size: 12px;
}

.edu-academic-kpi strong {
    display: block;
    font-size: 27px;
    margin-top: 7px;
    color: #172033;
}

.edu-academic-performance {
    margin-top: 22px;
}

.edu-academic-performance-title {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 15px;
}

.edu-academic-bar {
    margin-bottom: 13px;
}

.edu-academic-bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 6px;
    color: #5f6878;
}

.edu-academic-bar-track {
    height: 8px;
    background: #e8edf4;
    border-radius: 10px;
    overflow: hidden;
}

.edu-academic-bar-fill {
    height: 100%;
    background: #2864c7;
    border-radius: 10px;
}

/* =========================
   SECTION COMMON
   ========================= */

.edu-academic-section {
    padding: 90px 0;
}

.edu-academic-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 50px;
}

.edu-academic-heading span {
    color: #2864c7;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.edu-academic-heading h2 {
    font-size: 40px;
    line-height: 1.2;
    margin: 12px 0 16px;
    font-weight: 800;
}

.edu-academic-heading p {
    color: #687282;
    font-size: 17px;
    line-height: 1.7;
}

/* =========================
   FEATURE CARDS
   ========================= */

.edu-academic-features {
    background: #ffffff;
}

.edu-academic-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.edu-academic-feature-card {
    background: #f8fafc;
    border: 1px solid #e7ecf3;
    border-radius: 15px;
    padding: 30px;
    transition: 0.25s;
}

.edu-academic-feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 35px rgba(30,55,90,0.09);
    background: #ffffff;
}

.edu-academic-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: #e8f1ff;
    color: #2864c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 23px;
    margin-bottom: 20px;
}

.edu-academic-feature-card h3 {
    font-size: 19px;
    margin: 0 0 10px;
}

.edu-academic-feature-card p {
    color: #6b7483;
    line-height: 1.65;
    margin: 0;
    font-size: 14px;
}

/* =========================
   WORKFLOW
   ========================= */

.edu-academic-workflow {
    background: #f5f8fc;
}

.edu-academic-workflow-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
}

.edu-academic-step {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 13px;
    padding: 23px 16px;
    text-align: center;
}

.edu-academic-step-number {
    width: 39px;
    height: 39px;
    margin: 0 auto 15px;
    border-radius: 50%;
    background: #2864c7;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
}

.edu-academic-step h4 {
    margin: 0 0 8px;
    font-size: 14px;
}

.edu-academic-step p {
    margin: 0;
    color: #737c8a;
    font-size: 12px;
    line-height: 1.5;
}

/* =========================
   RECORDS SECTION
   ========================= */

.edu-academic-records {
    background: #172033;
    color: #ffffff;
    padding: 90px 0;
}

.edu-academic-records-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 70px;
    align-items: center;
}

.edu-academic-records-text span {
    color: #8db9ff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.edu-academic-records-text h2 {
    font-size: 39px;
    line-height: 1.2;
    margin: 15px 0 18px;
}

.edu-academic-records-text p {
    color: #b9c2d1;
    line-height: 1.7;
    font-size: 16px;
}

.edu-academic-record-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.edu-academic-record {
    background: #202b40;
    border: 1px solid #344056;
    border-radius: 12px;
    padding: 20px;
}

.edu-academic-record strong {
    display: block;
    font-size: 15px;
    margin-bottom: 7px;
}

.edu-academic-record small {
    color: #aeb8c8;
    line-height: 1.5;
}

/* =========================
   BENEFITS
   ========================= */

.edu-academic-benefits {
    background: #ffffff;
}

.edu-academic-benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.edu-academic-benefit {
    padding: 28px 22px;
    border: 1px solid #e4e9f0;
    border-radius: 14px;
    background: #ffffff;
}

.edu-academic-benefit-number {
    color: #2864c7;
    font-size: 27px;
    font-weight: 800;
    margin-bottom: 14px;
}

.edu-academic-benefit h3 {
    font-size: 17px;
    margin: 0 0 9px;
}

.edu-academic-benefit p {
    color: #707988;
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
}

/* =========================
   CTA
   ========================= */

.edu-academic-cta {
    background: linear-gradient(135deg, #eef5ff, #f8fbff);
    padding: 85px 0;
    text-align: center;
}

.edu-academic-cta h2 {
    font-size: 40px;
    margin: 0 0 15px;
    font-weight: 800;
}

.edu-academic-cta p {
    color: #687282;
    font-size: 17px;
    max-width: 650px;
    margin: 0 auto 28px;
    line-height: 1.7;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 1100px) {

    .edu-academic-hero-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .edu-academic-hero h1 {
        font-size: 48px;
    }

    .edu-academic-feature-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-academic-workflow-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .edu-academic-benefit-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-academic-records-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

@media (max-width: 650px) {

    .edu-academic-container {
        width: 90%;
    }

    .edu-academic-hero {
        padding: 65px 0;
    }

    .edu-academic-hero h1 {
        font-size: 38px;
    }

    .edu-academic-hero p {
        font-size: 16px;
    }

    .edu-academic-btn,
    .edu-academic-btn-light {
        display: block;
        text-align: center;
        margin: 0 0 12px;
    }

    .edu-academic-feature-grid {
        grid-template-columns: 1fr;
    }

    .edu-academic-workflow-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-academic-benefit-grid {
        grid-template-columns: 1fr;
    }

    .edu-academic-record-list {
        grid-template-columns: 1fr;
    }

    .edu-academic-heading h2,
    .edu-academic-records-text h2,
    .edu-academic-cta h2 {
        font-size: 30px;
    }

    .edu-academic-section,
    .edu-academic-records {
        padding: 65px 0;
    }
}
                ]]></style>


