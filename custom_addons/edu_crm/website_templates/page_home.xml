/* ============================================================
   RESPONSIVE - TABLET
   ============================================================ */

@media (max-width: 1100px) {

    .edu-home-hero-grid {
        grid-template-columns: 1fr;

        gap: 45px;
    }

    .edu-home-intro-grid {
        grid-template-columns: 1fr;

        gap: 35px;
    }

    .edu-home-feature-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-home-module-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-home-workflow-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .edu-home-benefit-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-home-reporting-grid {
        grid-template-columns: 1fr;

        gap: 40px;
    }

}


/* ============================================================
   RESPONSIVE - MOBILE
   ============================================================ */

@media (max-width: 700px) {

    .edu-home-container {
        width: 90% !important;
    }

    .edu-home-hero {
        padding: 65px 0 60px !important;
    }

    .edu-home-hero h1 {
        font-size: 39px;

        letter-spacing: -1px;
    }

    .edu-home-hero-text {
        font-size: 16px;
    }

    .edu-home-btn,
    .edu-home-btn-light {
        display: block;

        width: 100%;

        margin: 0 0 12px;

        text-align: center;
    }

    .edu-home-btn-light {
        margin-left: 0;
    }

    .edu-home-feature-grid,
    .edu-home-module-grid,
    .edu-home-benefit-grid {
        grid-template-columns: 1fr;
    }

    .edu-home-workflow-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-home-report-grid {
        grid-template-columns: 1fr;
    }

    .edu-home-kpi-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-home-heading h2,
    .edu-home-intro h2,
    .edu-home-reporting h2,
    .edu-home-cta h2 {
        font-size: 30px;
    }

    .edu-home-features,
    .edu-home-modules,
    .edu-home-workflow,
    .edu-home-reporting,
    .edu-home-benefits {
        padding: 65px 0;
    }

}


/* ============================================================
   SMALL MOBILE
   ============================================================ */

@media (max-width: 450px) {

    .edu-home-hero h1 {
        font-size: 34px;
    }

    .edu-home-dashboard {
        padding: 18px;
    }

    .edu-home-kpi-grid {
        grid-template-columns: 1fr;
    }

    .edu-home-workflow-grid {
        grid-template-columns: 1fr;
    }

}

