                        Keep guardians informed with accurate, up to
                        date information.
                    </p>
                </div>


                <div class="edu-student-benefit">
                    <div class="edu-student-benefit-number">04</div>

                    <h3>Easy Reporting</h3>

                    <p>
                        Generate student reports whenever they are
                        needed.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
