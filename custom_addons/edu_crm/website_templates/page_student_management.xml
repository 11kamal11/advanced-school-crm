<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_student_management" name="Student Management Page Content">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <style><![CDATA[
/* =========================================================
   SCHOOL CRM - STUDENT MANAGEMENT
   ========================================================= */

.edu-student {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    padding: 0 !important;
    overflow: hidden;
    background: #ffffff;
    color: #172033;
    font-family: Arial, Helvetica, sans-serif;
}

.edu-student * {
    box-sizing: border-box;
}

.edu-student-container {
    width: 94%;
    max-width: 1450px;
    margin: 0 auto;
}

/* HERO */

.edu-student-hero {
    padding: 90px 0;
    background:
        radial-gradient(circle at 82% 18%, rgba(40,100,199,0.15), transparent 30%),
        linear-gradient(135deg, #f4f8ff 0%, #ffffff 60%, #eef5ff 100%);
}

.edu-student-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 65px;
    align-items: center;
}

.edu-student-badge {
    display: inline-block;
    padding: 9px 17px;
    border-radius: 30px;
    background: #e8f1ff;
    color: #2864c7;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 20px;
}

.edu-student-hero h1 {
    font-size: 55px;
    line-height: 1.08;
    letter-spacing: -1.5px;
    margin: 0 0 22px;
    font-weight: 800;
}

.edu-student-hero h1 span {
    color: #2864c7;
}

.edu-student-hero p {
    max-width: 670px;
    color: #687282;
    font-size: 18px;
    line-height: 1.7;
    margin: 0 0 30px;
}

.edu-student-btn {
    display: inline-block;
    padding: 15px 28px;
    border-radius: 8px;
    background: #2864c7;
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: 15px;
    font-weight: 700;
    transition: 0.25s;
}

.edu-student-btn:hover {
    background: #1e4f9f;
    transform: translateY(-2px);
}

.edu-student-btn-light {
    display: inline-block;
    padding: 14px 27px;
    margin-left: 8px;
    border-radius: 8px;
    border: 1px solid #d8e0ec;
    background: #ffffff;
    color: #172033 !important;
    text-decoration: none !important;
    font-size: 15px;
    font-weight: 700;
}

/* STUDENT PROFILE VISUAL */

.edu-student-profile {
    background: #ffffff;
    border: 1px solid #e0e7f0;
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 20px 55px rgba(30,55,90,0.12);
}

.edu-student-profile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid #edf0f5;
}

.edu-student-profile-title {
    font-size: 17px;
    font-weight: 800;
}

.edu-student-status {
    background: #eaf7ef;
    color: #27834a;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
}

.edu-student-person {
    display: flex;
    align-items: center;
    gap: 17px;
    padding: 23px 0;
}

.edu-student-avatar {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: #e8f1ff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2864c7;
    font-size: 28px;
    font-weight: 800;
}

.edu-student-person h3 {
    margin: 0 0 5px;
    font-size: 19px;
}

.edu-student-person p {
    margin: 0;
    color: #747d8d;
    font-size: 13px;
}

.edu-student-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.edu-student-detail {
    padding: 15px;
    background: #f7f9fc;
    border-radius: 10px;
}

.edu-student-detail small {
    display: block;
    color: #7a8391;
    font-size: 11px;
    margin-bottom: 6px;
}

.edu-student-detail strong {
    font-size: 14px;
}

.edu-student-progress {
    margin-top: 20px;
}

.edu-student-progress-title {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 8px;
    color: #626c7b;
}

.edu-student-progress-track {
    height: 9px;
    background: #e8edf4;
    border-radius: 10px;
    overflow: hidden;
}

.edu-student-progress-fill {
    height: 100%;
    width: 84%;
    background: #2864c7;
    border-radius: 10px;
}

/* SECTION COMMON */

.edu-student-section {
    padding: 90px 0;
}

.edu-student-light {
    background: #f5f8fc;
}

.edu-student-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 50px;
}

.edu-student-heading span {
    color: #2864c7;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.edu-student-heading h2 {
    font-size: 40px;
    line-height: 1.2;
    margin: 12px 0 15px;
    font-weight: 800;
}

.edu-student-heading p {
    color: #687282;
    font-size: 16px;
    line-height: 1.7;
}

/* FEATURE CARDS */

.edu-student-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.edu-student-feature {
    padding: 30px;
    background: #f8fafc;
    border: 1px solid #e4e9f0;
    border-radius: 15px;
    transition: 0.25s;
}

.edu-student-feature:hover {
    transform: translateY(-5px);
    background: #ffffff;
    box-shadow: 0 14px 35px rgba(30,55,90,0.09);
}

.edu-student-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: #e8f1ff;
    color: #2864c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 19px;
}

.edu-student-feature h3 {
    margin: 0 0 9px;
    font-size: 19px;
}

.edu-student-feature p {
    margin: 0;
    color: #707988;
    font-size: 14px;
    line-height: 1.65;
}

/* LIFECYCLE */

.edu-student-process {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
}

.edu-student-process-card {
    text-align: center;
    border: 1px solid #e1e7ef;
    border-radius: 13px;
    padding: 25px 15px;
    background: #ffffff;
}

.edu-student-number {
    width: 42px;
    height: 42px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: #2864c7;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
}

.edu-student-process-card h4 {
    margin: 0 0 8px;
    font-size: 14px;
}

.edu-student-process-card p {
    margin: 0;
    color: #737c8a;
    font-size: 12px;
    line-height: 1.5;
}

/* RECORDS - DARK */

.edu-student-records {
    background: #172033;
    color: #ffffff;
    padding: 90px 0;
}

.edu-student-records-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 65px;
    align-items: center;
}

.edu-student-records-text span {
    color: #8db9ff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.edu-student-records-text h2 {
    font-size: 39px;
    line-height: 1.2;
    margin: 14px 0 18px;
}

.edu-student-records-text p {
    color: #b9c3d2;
    font-size: 16px;
    line-height: 1.7;
}

.edu-student-record-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.edu-student-record {
    padding: 21px;
    border-radius: 12px;
    background: #202b40;
    border: 1px solid #344056;
}

.edu-student-record strong {
    display: block;
    margin-bottom: 7px;
    font-size: 15px;
}

.edu-student-record small {
    color: #aeb8c8;
    font-size: 12px;
    line-height: 1.5;
}

/* BENEFITS */

.edu-student-benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.edu-student-benefit {
    border: 1px solid #e1e7ef;
    border-radius: 14px;
    padding: 28px 22px;
}

.edu-student-benefit-number {
    color: #2864c7;
    font-size: 27px;
    font-weight: 800;
    margin-bottom: 13px;
}

.edu-student-benefit h3 {
    margin: 0 0 9px;
    font-size: 17px;
}

.edu-student-benefit p {
    margin: 0;
    color: #707988;
    font-size: 13px;
    line-height: 1.6;
}

/* CTA */

.edu-student-cta {
    padding: 85px 0;
    text-align: center;
    background: linear-gradient(135deg, #eef5ff, #f8fbff);
}

.edu-student-cta h2 {
    font-size: 40px;
    margin: 0 0 15px;
    font-weight: 800;
}

.edu-student-cta p {
    max-width: 650px;
    margin: 0 auto 27px;
    color: #687282;
    font-size: 16px;
    line-height: 1.7;
}

/* RESPONSIVE */

@media (max-width: 1100px) {

    .edu-student-hero-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .edu-student-feature-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-student-process {
        grid-template-columns: repeat(3, 1fr);
    }

    .edu-student-benefit-grid {
        grid-template-columns: 1fr 1fr;
    }

    .edu-student-records-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

@media (max-width: 700px) {

    .edu-student-container {
        width: 90%;
    }

    .edu-student-hero {
        padding: 65px 0;
    }

    .edu-student-hero h1 {
        font-size: 38px;
    }

    .edu-student-hero p {
        font-size: 16px;
    }

    .edu-student-btn,
    .edu-student-btn-light {
        display: block;
        width: 100%;
        text-align: center;
        margin: 0 0 12px;
    }

    .edu-student-btn-light {
        margin-left: 0;
    }

    .edu-student-feature-grid {
        grid-template-columns: 1fr;
    }

    .edu-student-process {
        grid-template-columns: 1fr 1fr;
    }

    .edu-student-benefit-grid {
        grid-template-columns: 1fr;
    }

    .edu-student-record-grid {
        grid-template-columns: 1fr;
    }

    .edu-student-details {
        grid-template-columns: 1fr;
    }

    .edu-student-heading h2,
    .edu-student-records-text h2,
    .edu-student-cta h2 {
        font-size: 30px;
    }

    .edu-student-section,
    .edu-student-records {
        padding: 65px 0;
    }
}
                ]]></style>


<div class="edu-student">

    <!-- HERO -->
