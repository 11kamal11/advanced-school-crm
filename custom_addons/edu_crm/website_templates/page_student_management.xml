        <div class="edu-student-container">

            <div class="edu-student-records-grid">

                <div class="edu-student-records-text">

                    <span>Centralized Student Records</span>

                    <h2>
                        Keep Student Information Connected
                    </h2>

                    <p>
                        Store important student information in one
