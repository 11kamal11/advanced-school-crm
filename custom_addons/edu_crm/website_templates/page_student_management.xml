            </div>

        </div>
    </section>


    <!-- FEATURES -->
    <section class="edu-student-section">

        <div class="edu-student-container">

            <div class="edu-student-heading">

                <span>Student Tools</span>

                <h2>
                    Everything You Need to Manage Students
                </h2>

                <p>
                    Keep student information organized and accessible
                    throughout the school year.
                </p>

            </div>


            <div class="edu-student-feature-grid">

                <div class="edu-student-feature">
                    <div class="edu-student-icon">👤</div>

