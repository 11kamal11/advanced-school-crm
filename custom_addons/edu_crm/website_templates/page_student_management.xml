                    <div class="edu-student-number">4</div>
                    <h4>Promoted</h4>
                    <p>Advances to the next academic year.</p>
                </div>

                <div class="edu-student-process-card">
                    <div class="edu-student-number">5</div>
                    <h4>Graduated</h4>
                    <p>Completes the academic program.</p>
                </div>

            </div>

        </div>

    </section>


    <!-- RECORDS -->
