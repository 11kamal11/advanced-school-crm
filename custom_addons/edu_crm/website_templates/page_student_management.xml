            </a>

        </div>

    </section>

</div>
            </div>
        </t>
    </template>

    <record id="page_student_management_page" model="website.page">
        <field name="name">Student Management</field>
        <field name="url">/student-management</field>
        <field name="view_id" ref="page_student_management"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

</odoo>
