            <div id="wrap" class="oe_structure">
                <style><![CDATA[
/* =========================================================
   SCHOOL EDUCATION CRM - FEATURES PAGE
   ODOO FULL WIDTH VERSION
   ========================================================= */

.edu-features {
    width: 100vw !important;
    max-width: none !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    padding: 0 !important;
    box-sizing: border-box !important;
    font-family: Arial, Helvetica, sans-serif;
    color: #172033;
    background: #ffffff;
}

.edu-features *,
.edu-features *::before,
.edu-features *::after {
    box-sizing: border-box;
}

/* ---------------------------------------------------------
   CONTAINER
   --------------------------------------------------------- */

.edu-container {
    width: 94% !important;
    max-width: 1450px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
}

/* ---------------------------------------------------------
   HERO
   --------------------------------------------------------- */

.edu-feature-hero {
    width: 100% !important;
    min-height: 560px;
    padding: 90px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background:
        radial-gradient(circle at top right, rgba(67, 125, 220, 0.12), transparent 35%),
        linear-gradient(135deg, #eef5ff 0%, #f8fbff 50%, #ffffff 100%);
}

.edu-feature-hero .edu-container {
    max-width: 1100px !important;
}

.edu-badge {
    display: inline-block;
    background: #e5efff;
    color: #2864c7;
    padding: 10px 20px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 25px;
    letter-spacing: 0.3px;
}

.edu-feature-hero h1 {
    font-size: clamp(42px, 5vw, 68px) !important;
    line-height: 1.1 !important;
    max-width: 1050px !important;
    margin: 0 auto 25px !important;
    font-weight: 700 !important;
    color: #172033;
}

.edu-feature-hero h1 span {
    color: #2864c7;
}

.edu-feature-hero p {
    max-width: 850px !important;
    margin: 0 auto !important;
    color: #657184;
    font-size: 20px !important;
    line-height: 1.7 !important;
}

/* ---------------------------------------------------------
   GENERAL SECTIONS
   --------------------------------------------------------- */

.edu-section {
    width: 100% !important;
    padding: 90px 20px !important;
}

.edu-section-light {
    background: #f7f9fc;
}

.edu-heading {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 55px;
}

.edu-heading h2 {
    font-size: clamp(30px, 3vw, 42px) !important;
    line-height: 1.2;
    margin: 0 0 18px !important;
    color: #172033;
    font-weight: 700 !important;
}

.edu-heading p {
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: #687385;
    margin: 0 !important;
}

/* ---------------------------------------------------------
   FEATURE CARDS
   --------------------------------------------------------- */

.edu-feature-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 28px !important;
    width: 100% !important;
}

.edu-card {
    background: #ffffff;
    border: 1px solid #e3e8f0;
    border-radius: 18px;
    padding: 35px !important;
    min-height: 330px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 3px 12px rgba(25, 45, 80, 0.03);
}

.edu-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 18px 45px rgba(25, 45, 80, 0.10);
}

.edu-icon {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: #eaf1ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
    margin-bottom: 22px;
}

.edu-card h3 {
    font-size: 22px !important;
    line-height: 1.3;
    margin: 0 0 13px !important;
    color: #172033;
    font-weight: 700 !important;
}

.edu-card p {
    color: #687385;
    line-height: 1.65 !important;
    font-size: 15px !important;
    margin: 0 !important;
}

.edu-card ul {
    padding-left: 20px !important;
    margin: 18px 0 0 !important;
    color: #687385;
    line-height: 1.9 !important;
    font-size: 14px !important;
}

/* ---------------------------------------------------------
   STUDENT LIFECYCLE
   --------------------------------------------------------- */

.edu-process {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    gap: 18px !important;
}

.edu-process-card {
    text-align: center;
    background: #ffffff;
    border: 1px solid #e3e8f0;
    border-radius: 16px;
    padding: 30px 18px !important;
    box-shadow: 0 3px 12px rgba(25, 45, 80, 0.03);
}

.edu-number {
    width: 46px;
    height: 46px;
    background: #2864c7;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 17px;
    font-weight: 700;
    font-size: 17px;
}

.edu-process-card h4 {
    margin: 0 0 9px !important;
    font-size: 18px !important;
    color: #172033;
    font-weight: 700 !important;
}

.edu-process-card p {
    margin: 0 !important;
    color: #687385;
    font-size: 14px !important;
    line-height: 1.5 !important;
}

/* ---------------------------------------------------------
   DASHBOARD SECTION
   --------------------------------------------------------- */

.edu-dashboard {
    width: 100%;
    background: linear-gradient(135deg, #172033, #243451);
    border-radius: 24px;
    padding: 65px !important;
    color: #ffffff;
    box-shadow: 0 20px 50px rgba(23, 32, 51, 0.12);
}

.edu-dashboard h2 {
    margin: 0 0 15px !important;
    font-size: clamp(30px, 3vw, 42px) !important;
    line-height: 1.2;
    color: #ffffff;
}

.edu-dashboard p {
    color: #c6cedb;
    max-width: 750px;
    line-height: 1.7 !important;
    font-size: 17px !important;
    margin: 0 !important;
}

.edu-dashboard-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 20px !important;
    margin-top: 40px;
}

.edu-dashboard-card {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 14px;
    padding: 28px !important;
}

.edu-dashboard-card span {
    display: block;
    color: #aeb8c9;
    font-size: 14px !important;
    margin-bottom: 12px;
}

.edu-dashboard-card strong {
    display: block;
    font-size: 32px !important;
    color: #ffffff;
}

/* ---------------------------------------------------------
   BENEFITS
   --------------------------------------------------------- */

.edu-benefit-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 22px !important;
}

.edu-benefit {
    text-align: center;
    padding: 35px 25px !important;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #e3e8f0;
}

.edu-benefit-icon {
    font-size: 32px;
    margin-bottom: 17px;
}

.edu-benefit h3 {
    font-size: 19px !important;
    margin: 0 0 10px !important;
    color: #172033;
}

.edu-benefit p {
    color: #687385;
    font-size: 14px !important;
    line-height: 1.6 !important;
    margin: 0 !important;
}

/* ---------------------------------------------------------
   CTA
   --------------------------------------------------------- */

.edu-cta {
    width: 100% !important;
    background: linear-gradient(135deg, #2864c7, #1e56ad);
    color: #ffffff;
    text-align: center;
    padding: 90px 20px !important;
}

.edu-cta h2 {
    font-size: clamp(30px, 3vw, 43px) !important;
    line-height: 1.2;
    margin: 0 0 18px !important;
    color: #ffffff;
}

.edu-cta p {
    font-size: 18px !important;
    line-height: 1.6;
    margin: 0 auto 30px !important;
    color: #e8f0ff;
    max-width: 700px;
}

.edu-button {
    display: inline-block !important;
    padding: 15px 30px !important;
    border-radius: 9px;
    text-decoration: none !important;
    font-weight: 700 !important;
    margin: 5px;
    transition: transform 0.2s ease;
}

.edu-button:hover {
    transform: translateY(-2px);
}

.edu-button-white {
    background: #ffffff !important;
    color: #2864c7 !important;
}

/* ---------------------------------------------------------
   TABLET
   --------------------------------------------------------- */

@media (max-width: 1100px) {

    .edu-container {
        width: 96% !important;
    }

    .edu-feature-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .edu-process {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }

    .edu-dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .edu-benefit-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 650px) {

    .edu-features {
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .edu-container {
        width: 100% !important;
        padding-left: 16px !important;
        padding-right: 16px !important;
    }

    .edu-feature-hero {
        min-height: 480px;
        padding: 70px 18px;
    }

    .edu-feature-hero h1 {
        font-size: 38px !important;
    }

    .edu-feature-hero p {
        font-size: 17px !important;
    }

    .edu-section {
        padding: 65px 16px !important;
    }

    .edu-feature-grid,
    .edu-process,
    .edu-dashboard-grid,
    .edu-benefit-grid {
        grid-template-columns: 1fr !important;
    }

    .edu-card {
        min-height: auto;
        padding: 28px !important;
    }

    .edu-dashboard {
        padding: 35px 25px !important;
        border-radius: 18px;
    }

    .edu-cta {
        padding: 70px 18px !important;
    }
}
                ]]></style>


