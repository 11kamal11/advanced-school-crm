<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Override the default Odoo /contactus page.
            Keeps the "Contact us" title/hero banner but removes the form section,
            leaving a clean blank page that can be edited via Website builder.
        -->
        <template id="contactus_blank" inherit_id="website.contactus" name="Contact Us – Blank">
            <!-- Remove the form + company info section entirely -->
            <xpath expr="//section[hasclass('s_text_block')]" position="replace"/>
        </template>
    </data>
</odoo>
