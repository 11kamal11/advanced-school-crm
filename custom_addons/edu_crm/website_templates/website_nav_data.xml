<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Point "/" at the new custom homepage without touching the
         reserved website.homepage view (avoids multi-website COW
         conflicts on ir.ui.view).

         Done via a direct method call (not a <record> field write):
         `website.default_website` was originally created by the
         `website` module inside a noupdate="1" block, so a plain
         <record> field update here would be silently skipped by
         Odoo's loader on every module *upgrade* (-u) — only a fresh
         *install* (-i) would apply it. A <function> call is not
         subject to that guard, so this stays correct on both.
         ============================================================ -->
    <function model="website" name="write"
              eval="[[ref('website.default_website')], {'homepage_url': '/home'}]"/>

    <!-- ============================================================
         Top-menu entries for the School CRM site, matching the
         agreed sitemap. Scoped to website.default_website only —
         the secondary demo website is left untouched.
         ============================================================ -->
    <record id="menu_home" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/</field>
        <field name="parent_id" search="[('website_id', '=', ref('website.default_website')), ('parent_id', '=', False)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence">10</field>
    </record>

    <record id="menu_admissions" model="website.menu">
        <field name="name">Admissions</field>
        <field name="url">/admissions</field>
        <field name="parent_id" search="[('website_id', '=', ref('website.default_website')), ('parent_id', '=', False)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence">20</field>
    </record>

