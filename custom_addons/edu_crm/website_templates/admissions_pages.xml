                                    <span class="edu-program-link">
                                        View details <i class="fa fa-arrow-right"></i>
                                    </span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div t-else="" class="text-center py-5">
                        <i class="fa fa-graduation-cap fa-3x text-muted mb-3"></i>
                        <p class="text-muted fs-5">Program details are being updated. Please check back soon.</p>
                        <a href="/admissions" class="btn btn-outline-primary mt-2">Back to Admissions</a>
                    </div>
                </div>
            </section>

            <!-- CTA -->
            <section class="edu-section edu-section-tint">
