<template id="admissions_programs" name="Programs Listing">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure">

            <section class="edu-page-hero">
                <div class="container position-relative" style="z-index:1">
                    <a href="/admissions" class="edu-breadcrumb">
                        <i class="fa fa-arrow-left"></i> Admissions
                    </a>
                    <h1>Our Academic Programs</h1>
                    <p class="edu-page-subtitle">
                        Every program is built around a clear academic path and measurable outcomes.
                    </p>
                </div>
            </section>

            <section class="edu-section">
                <div class="container">
                    <div t-if="programs">
                        <div class="edu-program-grid">
                            <a t-foreach="programs" t-as="program"
                               t-attf-href="/admissions/programs/#{program.id}"
                               class="edu-program-card">
                                <div t-if="program.image" class="edu-program-img"
