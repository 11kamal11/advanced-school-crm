                            <div class="edu-stat-icon"><i class="fa fa-graduation-cap"></i></div>
                            <span class="edu-stat-number edu-count-up" t-att-data-target="stats['teachers']" data-suffix="+">
                                <t t-out="stats['teachers']"/>
                            </span>
                            <span class="edu-stat-label">Faculty Members</span>
                        </div>
                        <div class="edu-stat-item edu-anim-up" style="transition-delay:0.2s">
                            <div class="edu-stat-icon"><i class="fa fa-book"></i></div>
                            <span class="edu-stat-number edu-count-up" t-att-data-target="stats['programs']" data-suffix="">
                                <t t-out="stats['programs']"/>
                            </span>
                            <span class="edu-stat-label">Academic Programs</span>
                        </div>
                        <div class="edu-stat-item edu-anim-up" style="transition-delay:0.3s">
                            <div class="edu-stat-icon"><i class="fa fa-star"></i></div>
                            <span class="edu-stat-number" data-suffix="">40</span>
                            <span class="edu-stat-label">Years of Excellence</span>
                        </div>
                    </div>
                </div>
