                            <h3 class="edu-cta-heading">Start your application today.</h3>
                            <p class="edu-cta-sub">Our team will guide you through every step of the admissions process.</p>
                        </div>
                        <div class="edu-cta-actions">
                            <a href="/admissions/inquiry" class="btn btn-edu-primary btn-lg">
                                <i class="fa fa-edit me-2"></i>Apply Now
                            </a>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </t>
</template>


