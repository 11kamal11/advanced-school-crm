            <!-- Why Choose Us -->
            <section class="edu-section">
                <div class="container">
                    <div class="edu-section-head text-center">
                        <span class="edu-eyebrow">Why Choose Us</span>
                        <h2 class="edu-heading">An environment built for <em style="font-style:normal;color:#C8871A;">curiosity</em></h2>
                        <p class="edu-subheading mx-auto">
                            From our faculty to our facilities, every decision we make is driven
                            by one question: what's best for the student?
                        </p>
                    </div>
                    <div class="edu-feature-grid">
                        <div class="edu-feature-card edu-anim-up">
                            <div class="edu-feature-icon edu-fi-prussian">
                                <i class="fa fa-graduation-cap"></i>
                            </div>
                            <p class="edu-feature-title">Academic Excellence</p>
                            <p class="edu-feature-desc">
                                Consistently top-ranked results with a curriculum designed to challenge,
                                engage, and prepare students for higher education.
                            </p>
                        </div>
                        <div class="edu-feature-card edu-anim-up" style="transition-delay:0.1s">
                            <div class="edu-feature-icon edu-fi-saffron">
                                <i class="fa fa-heart"></i>
                            </div>
                            <p class="edu-feature-title">Holistic Development</p>
                            <p class="edu-feature-desc">
                                Sports, arts, culture, and community service programs that develop
                                well-rounded, emotionally intelligent young adults.
                            </p>
                        </div>
                        <div class="edu-feature-card edu-anim-up" style="transition-delay:0.2s">
                            <div class="edu-feature-icon edu-fi-forest">
                                <i class="fa fa-users"></i>
                            </div>
                            <p class="edu-feature-title">Dedicated Faculty</p>
                            <p class="edu-feature-desc">
                                Experienced educators who know every student by name and are committed
                                to helping each child reach their full potential.
                            </p>
                        </div>
                        <div class="edu-feature-card edu-anim-up" style="transition-delay:0.3s">
                            <div class="edu-feature-icon edu-fi-purple">
                                <i class="fa fa-shield"></i>
                            </div>
                            <p class="edu-feature-title">Safe &amp; Inclusive</p>
                            <p class="edu-feature-desc">
                                A campus where every child feels welcome, respected, and supported —
                                regardless of background or learning style.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Counter + scroll-reveal JS -->
            <script>
                (function () {
                    function animateCounter(el) {
                        var target = parseFloat(el.dataset.target) || 0;
                        var suffix = el.dataset.suffix || '';
                        var inc = target / (1600 / 16);
                        var current = 0;
                        var timer = setInterval(function () {
                            current = Math.min(current + inc, target);
                            el.textContent = Math.round(current).toLocaleString('en-IN') + suffix;
                            if (current >= target) clearInterval(timer);
                        }, 16);
                    }
                    var io = new IntersectionObserver(function (entries) {
                        entries.forEach(function (e) {
                            if (!e.isIntersecting) return;
                            io.unobserve(e.target);
                            if (e.target.classList.contains('edu-count-up')) animateCounter(e.target);
                            if (e.target.classList.contains('edu-anim-up')) e.target.classList.add('is-visible');
                        });
                    }, { threshold: 0.25 });
                    document.querySelectorAll('.edu-count-up, .edu-anim-up').forEach(function (el) { io.observe(el); });
                })();
            </script>

        </div>
    </t>
</template>


