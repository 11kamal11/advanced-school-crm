<odoo>
    <record id="view_edu_asset_checkout_wizard_form" model="ir.ui.view">
        <field name="name">edu.asset.checkout.wizard.form</field>
        <field name="model">edu.asset.checkout.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="asset_id" invisible="1"/>
                <group>
                    <field name="teacher_id"/>
                    <field name="expected_return_date"/>
                    <field name="condition_on_checkout"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm_checkout" string="Check Out" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
