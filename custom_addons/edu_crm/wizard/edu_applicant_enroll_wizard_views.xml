<odoo>
    <record id="view_edu_applicant_enroll_wizard_form" model="ir.ui.view">
        <field name="name">edu.applicant.enroll.wizard.form</field>
        <field name="model">edu.applicant.enroll.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="applicant_id" invisible="1"/>
                <group>
                    <field name="class_id"/>
                    <field name="academic_year_id"/>
                    <field name="roll_number"/>
                    <field name="admission_date"/>
                </group>
                <footer>
                    <button name="action_enroll" string="Enroll" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
