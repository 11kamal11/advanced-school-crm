<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_overdue_fees" model="ir.cron">
            <field name="name">Edu CRM: Check Overdue Fees &amp; Send Reminders</field>
            <field name="model_id" ref="model_edu_fee"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_deactivate_expired_announcements" model="ir.cron">
            <field name="name">Edu CRM: Deactivate Expired Announcements</field>
            <field name="model_id" ref="model_edu_announcement"/>
            <field name="state">code</field>
            <field name="code">model._cron_deactivate_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
