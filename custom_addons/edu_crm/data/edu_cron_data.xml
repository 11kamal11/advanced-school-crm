<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron: Daily check for overdue fees and send reminders -->
    <record id="cron_check_overdue_fees" model="ir.cron">
        <field name="name">School CRM: Check Overdue Fees</field>
        <field name="model_id" ref="model_edu_fee"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
