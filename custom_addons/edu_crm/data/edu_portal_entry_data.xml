<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Portal home page entry for "My Children".
        The counter (children_count) is injected dynamically via
        EduPortal._prepare_home_portal_values() in controllers/portal.py.
        This template extension adds the tile to the standard portal home.
    -->
    <template id="portal_my_home_edu" name="Portal: My Children Entry"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Children</t>
                <t t-set="url">/my/children</t>
                <t t-set="count" t-value="children_count"/>
                <t t-set="placeholder_count">Children</t>
            </t>
        </xpath>
    </template>

</odoo>
