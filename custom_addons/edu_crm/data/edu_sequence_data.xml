<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence: Student Code -->
    <record id="seq_edu_student" model="ir.sequence">
        <field name="name">Student Code</field>
        <field name="code">edu.student</field>
        <field name="prefix">STU/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence: Applicant Reference -->
    <record id="seq_edu_applicant" model="ir.sequence">
        <field name="name">Applicant Reference</field>
        <field name="code">edu.applicant</field>
        <field name="prefix">APP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence: Fee Reference -->
    <record id="seq_edu_fee" model="ir.sequence">
        <field name="name">Fee Reference</field>
        <field name="code">edu.fee</field>
        <field name="prefix">FEE/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence: Teacher Employee Code -->
    <record id="seq_edu_teacher" model="ir.sequence">
        <field name="name">Teacher Employee Code</field>
        <field name="code">edu.teacher</field>
        <field name="prefix">TCH/%(year)s/</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
