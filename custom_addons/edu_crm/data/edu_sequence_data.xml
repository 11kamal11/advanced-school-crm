<odoo noupdate="1">
    <record id="seq_edu_student" model="ir.sequence">
        <field name="name">Student Code</field>
        <field name="code">edu.student</field>
        <field name="prefix">STU/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_edu_teacher" model="ir.sequence">
        <field name="name">Teacher Employee Code</field>
        <field name="code">edu.teacher</field>
        <field name="prefix">EMP/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_edu_attendance" model="ir.sequence">
        <field name="name">Attendance Reference</field>
        <field name="code">edu.attendance</field>
        <field name="prefix">ATT/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_edu_fee" model="ir.sequence">
        <field name="name">Fee Reference</field>
        <field name="code">edu.fee</field>
        <field name="prefix">FEE/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_edu_leave_request" model="ir.sequence">
        <field name="name">Leave Request Reference</field>
        <field name="code">edu.leave.request</field>
        <field name="prefix">LV/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_edu_applicant" model="ir.sequence">
        <field name="name">Applicant Reference</field>
        <field name="code">edu.applicant</field>
        <field name="prefix">APP/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_edu_asset" model="ir.sequence">
        <field name="name">Asset Code</field>
        <field name="code">edu.asset</field>
        <field name="prefix">AST/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
