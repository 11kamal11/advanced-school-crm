<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template: New inquiry notification to front-desk staff -->
    <record id="mail_template_new_lead_frontdesk" model="mail.template">
        <field name="name">New Admissions Inquiry</field>
        <field name="model_id" ref="model_edu_lead"/>
        <field name="subject">New Admissions Inquiry: {{ object.student_name or object.contact_name }}</field>
        <field name="body_html"><![CDATA[
<p>Hello,</p>
<p>A new admissions inquiry has been received via the school website.</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 12px; font-weight:bold; width:160px;">Contact Name</td>
        <td style="padding:6px 12px;">{{ object.contact_name }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Student Name</td>
        <td style="padding:6px 12px;">{{ object.student_name or '—' }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Class Applying For</td>
        <td style="padding:6px 12px;">{{ object.class_applying_id.display_name or '—' }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Phone</td>
        <td style="padding:6px 12px;">{{ object.phone or '—' }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Email</td>
        <td style="padding:6px 12px;">{{ object.email or '—' }}</td>
    </tr>
    {% if object.description %}
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold; vertical-align:top;">Message</td>
        <td style="padding:6px 12px;">{{ object.description }}</td>
    </tr>
    {% endif %}
</table>
<p style="margin-top:20px;">
    <a href="/web#model=edu.lead&amp;id={{ object.id }}"
       style="background:#875a7b; color:#fff; padding:8px 16px; border-radius:4px; text-decoration:none;">
        View Inquiry in Backend
    </a>
</p>
<p>Regards,<br/>School CRM System</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Template: Fee overdue / payment reminder sent to guardians -->
    <record id="mail_template_fee_reminder" model="mail.template">
        <field name="name">Fee Payment Reminder</field>
        <field name="model_id" ref="model_edu_fee"/>
        <field name="subject">Fee Payment Reminder – {{ object.student_id.name }}</field>
        <field name="email_to">{{ ','.join(object.student_id.guardian_ids.mapped('email') | select) }}</field>
        <field name="body_html"><![CDATA[
<p>Dear Parent / Guardian,</p>
<p>
    This is a reminder that the following fee for
    <strong>{{ object.student_id.name }}</strong> is now overdue.
</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 12px; font-weight:bold; width:160px;">Fee Reference</td>
        <td style="padding:6px 12px;">{{ object.name }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Fee Type</td>
        <td style="padding:6px 12px;">{{ object.fee_type | capitalize }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Amount Due</td>
        <td style="padding:6px 12px;">{{ object.balance }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Original Due Date</td>
        <td style="padding:6px 12px;">{{ object.due_date }}</td>
    </tr>
</table>
<p style="margin-top:16px;">
    Please visit the parent portal to view and pay outstanding fees, or contact the school finance office.
</p>
<p>Regards,<br/>School Finance Office</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Template: Application received confirmation to guardian/parent -->
    <record id="mail_template_application_received" model="mail.template">
        <field name="name">Application Received Confirmation</field>
        <field name="model_id" ref="model_edu_applicant"/>
        <field name="subject">Application Received – {{ object.name }}</field>
        <field name="email_to">{{ object.guardian_email or '' }}</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.guardian_name }},</p>
<p>
    Thank you for submitting an application for
    <strong>{{ object.student_name }}</strong>.
    We have received your application and it is currently under review.
</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 12px; font-weight:bold; width:160px;">Application No.</td>
        <td style="padding:6px 12px;">{{ object.name }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Student Name</td>
        <td style="padding:6px 12px;">{{ object.student_name }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Class Applied For</td>
        <td style="padding:6px 12px;">{{ object.class_applying_id.display_name or '—' }}</td>
    </tr>
</table>
<p style="margin-top:16px;">
    Our admissions team will contact you shortly with the next steps.
    If you have any questions, please do not hesitate to reach out.
</p>
<p>Regards,<br/>Admissions Team</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

</odoo>
