<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template: New inquiry notification to front-desk staff -->
    <record id="mail_template_new_lead_frontdesk" model="mail.template">
        <field name="name">New Admissions Inquiry</field>
        <field name="model_id" ref="model_edu_lead"/>
        <field name="subject">New Admissions Inquiry: {{ object.student_name or object.contact_name }}</field>
        <field name="email_to">{{ object.user_id.email or '' }}</field>
        <field name="body_html"><![CDATA[
<p>Hello,</p>
<p>A new admissions inquiry has been received via the school website.</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 12px; font-weight:bold; width:160px;">Contact Name</td>
        <td style="padding:6px 12px;">{{ object.contact_name }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Student Name</td>
        <td style="padding:6px 12px;">{{ object.student_name or '—' }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Class Applying For</td>
        <td style="padding:6px 12px;">{{ object.class_applying_id.display_name or '—' }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Phone</td>
        <td style="padding:6px 12px;">{{ object.phone or '—' }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Email</td>
        <td style="padding:6px 12px;">{{ object.email or '—' }}</td>
    </tr>
    {% if object.description %}
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold; vertical-align:top;">Message</td>
        <td style="padding:6px 12px;">{{ object.description }}</td>
    </tr>
    {% endif %}
</table>
<p style="margin-top:20px;">
    <a href="/web#model=edu.lead&amp;id={{ object.id }}"
       style="background:#875a7b; color:#fff; padding:8px 16px; border-radius:4px; text-decoration:none;">
        View Inquiry in Backend
    </a>
</p>
<p>Regards,<br/>School CRM System</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Template: Fee overdue / payment reminder sent to guardians -->
    <record id="mail_template_fee_reminder" model="mail.template">
        <field name="name">Fee Payment Reminder</field>
        <field name="model_id" ref="model_edu_fee"/>
        <field name="subject">Fee Payment Reminder – {{ object.student_id.name }}</field>
        <field name="email_to">{{ ', '.join(g.email for g in object.student_id.guardian_ids if g.email) }}</field>
        <field name="body_html"><![CDATA[
<p>Dear Parent / Guardian,</p>
<p>
    This is a reminder that the following fee for
    <strong>{{ object.student_id.name }}</strong> is now overdue.
</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 12px; font-weight:bold; width:160px;">Fee Reference</td>
        <td style="padding:6px 12px;">{{ object.name }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Fee Type</td>
        <td style="padding:6px 12px;">{{ object.fee_type | capitalize }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Amount Due</td>
        <td style="padding:6px 12px;">{{ object.balance }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Original Due Date</td>
        <td style="padding:6px 12px;">{{ object.due_date }}</td>
    </tr>
</table>
<p style="margin-top:16px;">
    Please visit the parent portal to view and pay outstanding fees, or contact the school finance office.
</p>
<p>Regards,<br/>School Finance Office</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Template: Exam result notification sent to guardians (per edu.exam.result record) -->
    <record id="mail_template_exam_result" model="mail.template">
        <field name="name">Exam Result Notification</field>
        <field name="model_id" ref="model_edu_exam_result"/>
        <field name="subject">Exam Results: {{ object.student_id.name }} – {{ object.exam_id.name }}</field>
        <field name="email_to">{{ ', '.join(g.email for g in object.student_id.guardian_ids if g.email) }}</field>
        <field name="body_html"><![CDATA[
<p>Dear Parent / Guardian,</p>
<p>
    The results for <strong>{{ object.exam_id.name }}</strong> have been published.
    Please find the details for <strong>{{ object.student_id.name }}</strong> below.
</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:8px 12px; font-weight:bold; width:180px; background:#f5f5f5;">Student</td>
        <td style="padding:8px 12px;">{{ object.student_id.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Exam</td>
        <td style="padding:8px 12px;">{{ object.exam_id.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Subject</td>
        <td style="padding:8px 12px;">{{ object.exam_id.subject_id.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Date</td>
        <td style="padding:8px 12px;">{{ object.exam_id.exam_date }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Marks Obtained</td>
        <td style="padding:8px 12px;">
            <strong>{{ object.marks_obtained }}</strong> / {{ object.exam_id.max_marks }}
            &nbsp;&nbsp;({{ "%.1f"|format(object.percentage) }}%)
        </td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Grade</td>
        <td style="padding:8px 12px; font-size:1.2em; font-weight:bold;">{{ object.grade }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Result</td>
        <td style="padding:8px 12px;">
            {% if object.is_passed %}
            <span style="color:#177A63; font-weight:bold;">✓ PASSED</span>
            {% else %}
            <span style="color:#C0392B; font-weight:bold;">✗ NEEDS IMPROVEMENT</span>
            {% endif %}
        </td>
    </tr>
    {% if object.remarks %}
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5; vertical-align:top;">Remarks</td>
        <td style="padding:8px 12px;">{{ object.remarks }}</td>
    </tr>
    {% endif %}
</table>
<p style="margin-top:20px;">
    You can view the full exam details and your child's progress by logging into the parent portal.
</p>
<p>Regards,<br/>Academic Office</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Template: Application received confirmation to guardian/parent -->
    <record id="mail_template_application_received" model="mail.template">
        <field name="name">Application Received Confirmation</field>
        <field name="model_id" ref="model_edu_applicant"/>
        <field name="subject">Application Received – {{ object.name }}</field>
        <field name="email_to">{{ object.guardian_email or '' }}</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.guardian_name }},</p>
<p>
    Thank you for submitting an application for
    <strong>{{ object.student_name }}</strong>.
    We have received your application and it is currently under review.
</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 12px; font-weight:bold; width:160px;">Application No.</td>
        <td style="padding:6px 12px;">{{ object.name }}</td>
    </tr>
    <tr style="background:#f9f9f9;">
        <td style="padding:6px 12px; font-weight:bold;">Student Name</td>
        <td style="padding:6px 12px;">{{ object.student_name }}</td>
    </tr>
    <tr>
        <td style="padding:6px 12px; font-weight:bold;">Class Applied For</td>
        <td style="padding:6px 12px;">{{ object.class_applying_id.display_name or '—' }}</td>
    </tr>
</table>
<p style="margin-top:16px;">
    Our admissions team will contact you shortly with the next steps.
    If you have any questions, please do not hesitate to reach out.
</p>
<p>Regards,<br/>Admissions Team</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

    <!-- Template: Leave request approved/rejected notification to guardian or teacher -->
    <record id="mail_template_leave_status" model="mail.template">
        <field name="name">Leave Request Status Notification</field>
        <field name="model_id" ref="model_edu_leave_request"/>
        <field name="subject">Leave Request {{ object.state | capitalize }}: {{ object.name }}</field>
        <field name="email_to">{{ ', '.join(g.email for g in object.student_id.guardian_ids if g.email) if object.applicant_type == 'student' else (object.teacher_id.email or '') }}</field>
        <field name="body_html"><![CDATA[
<p>Dear {{ object.student_id.guardian_ids[0].name if object.applicant_type == 'student' and object.student_id.guardian_ids else object.teacher_id.name }},</p>
<p>
    Your leave request has been
    <strong>{{ 'approved' if object.state == 'approved' else 'rejected' }}</strong>.
</p>
<table style="border-collapse:collapse; width:100%; font-family:sans-serif; font-size:14px;">
    <tr>
        <td style="padding:8px 12px; font-weight:bold; width:160px; background:#f5f5f5;">Reference</td>
        <td style="padding:8px 12px;">{{ object.name }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Leave Type</td>
        <td style="padding:8px 12px;">{{ object.leave_type | capitalize }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">From</td>
        <td style="padding:8px 12px;">{{ object.date_from }}</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">To</td>
        <td style="padding:8px 12px;">{{ object.date_to }} ({{ object.days }} days)</td>
    </tr>
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5;">Status</td>
        <td style="padding:8px 12px;">
            {% if object.state == 'approved' %}
            <span style="color:#177A63; font-weight:bold;">✓ APPROVED</span>
            {% else %}
            <span style="color:#C0392B; font-weight:bold;">✗ REJECTED</span>
            {% endif %}
        </td>
    </tr>
    {% if object.rejection_reason %}
    <tr>
        <td style="padding:8px 12px; font-weight:bold; background:#f5f5f5; vertical-align:top;">Reason</td>
        <td style="padding:8px 12px;">{{ object.rejection_reason }}</td>
    </tr>
    {% endif %}
</table>
<p style="margin-top:16px;">
    Please contact the school office if you have any questions.
</p>
<p>Regards,<br/>School Administration</p>
        ]]></field>
        <field name="auto_delete">True</field>
    </record>

</odoo>
