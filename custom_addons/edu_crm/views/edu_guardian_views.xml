<odoo>
    <!-- ── Search view ──────────────────────────────────────────── -->
    <record id="view_edu_guardian_search" model="ir.ui.view">
        <field name="name">edu.guardian.search</field>
        <field name="model">edu.guardian</field>
        <field name="arch" type="xml">
            <search string="Guardians">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <filter string="Has Portal Access" name="portal"
                        domain="[('has_portal_access','=',True)]"/>
                <filter string="No Portal Access" name="no_portal"
                        domain="[('has_portal_access','=',False)]"/>
                <group>
                    <filter name="group_relationship" string="Relationship"
                            context="{'group_by':'relationship'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_edu_guardian_list" model="ir.ui.view">
        <field name="name">edu.guardian.list</field>
        <field name="model">edu.guardian</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="relationship"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="has_portal_access"/>
            </list>
        </field>
    </record>

    <record id="view_edu_guardian_form" model="ir.ui.view">
        <field name="name">edu.guardian.form</field>
        <field name="model">edu.guardian</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_grant_portal_access" string="Grant Portal Access" type="object"
                            invisible="has_portal_access" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_children" type="object"
                                class="oe_stat_button" icon="fa-child">
                            <field name="child_count" widget="statinfo" string="Children"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="relationship"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="occupation"/>
                        </group>
                        <group>
                            <field name="has_portal_access"/>
                            <field name="student_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="action_edu_guardian" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">edu.guardian</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_guardian_search"/>
    </record>
</odoo>
