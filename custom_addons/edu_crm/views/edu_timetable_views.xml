<odoo>
    <record id="view_edu_timetable_list" model="ir.ui.view">
        <field name="name">edu.timetable.list</field>
        <field name="model">edu.timetable</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="room"/>
            </list>
        </field>
    </record>

    <record id="action_edu_timetable" model="ir.actions.act_window">
        <field name="name">Timetable</field>
        <field name="res_model">edu.timetable</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
