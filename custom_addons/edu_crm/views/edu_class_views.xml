<odoo>
    <!-- ── Search view ──────────────────────────────────────────── -->
    <record id="view_edu_class_search" model="ir.ui.view">
        <field name="name">edu.class.search</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <search string="Classes">
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="class_teacher_id"/>
                <filter string="Full" name="full" domain="[('is_full','=',True)]"/>
                <group>
                    <filter name="group_year"     string="Academic Year"   context="{'group_by':'academic_year_id'}"/>
                    <filter name="group_teacher"  string="Class Teacher"   context="{'group_by':'class_teacher_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_edu_class_list" model="ir.ui.view">
        <field name="name">edu.class.list</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="section"/>
                <field name="academic_year_id"/>
                <field name="class_teacher_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="view_edu_class_form" model="ir.ui.view">
        <field name="name">edu.class.form</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Grade 5"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="section"/>
                            <field name="academic_year_id"/>
                            <field name="class_teacher_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="student_count"/>
                            <field name="is_full"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subjects">
                            <field name="subject_ids"/>
                        </page>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="student_code"/>
                                    <field name="roll_number"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="action_edu_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">edu.class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_class_search"/>
    </record>
</odoo>
