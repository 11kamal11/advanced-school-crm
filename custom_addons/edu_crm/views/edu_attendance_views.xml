<odoo>
    <record id="view_edu_attendance_list" model="ir.ui.view">
        <field name="name">edu.attendance.list</field>
        <field name="model">edu.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="class_id"/>
                <field name="date"/>
                <field name="total_present"/>
                <field name="total_absent"/>
                <field name="total_late"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_edu_attendance_form" model="ir.ui.view">
        <field name="name">edu.attendance.form</field>
        <field name="model">edu.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state == 'confirmed'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="class_id"/>
                            <field name="subject_id"/>
                            <field name="date"/>
                            <field name="teacher_id"/>
                        </group>
                        <group>
                            <field name="total_present"/>
                            <field name="total_absent"/>
                            <field name="total_late"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="student_id"/>
                            <field name="status"/>
                            <field name="remarks"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edu_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">edu.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
