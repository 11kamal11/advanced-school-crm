<odoo>
    <!-- ── Search view ──────────────────────────────────────────── -->
    <record id="view_edu_subject_search" model="ir.ui.view">
        <field name="name">edu.subject.search</field>
        <field name="model">edu.subject</field>
        <field name="arch" type="xml">
            <search string="Subjects">
                <field name="name"/>
                <field name="code"/>
                <filter string="Theory"     name="theory"    domain="[('subject_type','=','theory')]"/>
                <filter string="Practical"  name="practical" domain="[('subject_type','=','practical')]"/>
                <filter string="Elective"   name="elective"  domain="[('is_elective','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Subject Type" context="{'group_by':'subject_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── List view ────────────────────────────────────────────── -->
    <record id="view_edu_subject_list" model="ir.ui.view">
        <field name="name">edu.subject.list</field>
        <field name="model">edu.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="subject_type"/>
                <field name="credit_hours"/>
                <field name="is_elective"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ────────────────────────────────────────────── -->
    <record id="view_edu_subject_form" model="ir.ui.view">
        <field name="name">edu.subject.form</field>
        <field name="model">edu.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="subject_type"/>
                            <field name="credit_hours"/>
                            <field name="is_elective"/>
                        </group>
                        <group>
                            <field name="class_ids" widget="many2many_tags"/>
                            <field name="teacher_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <!-- ── Action ───────────────────────────────────────────────── -->
    <record id="action_edu_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">edu.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_subject_search"/>
    </record>
</odoo>
