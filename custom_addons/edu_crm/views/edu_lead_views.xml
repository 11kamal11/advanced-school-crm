<odoo>
    <record id="view_edu_lead_kanban" model="ir.ui.view">
        <field name="name">edu.lead.kanban</field>
        <field name="model">edu.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="contact_name"/>
                        <field name="class_applying_id"/>
                        <footer class="pt-1 mt-0">
                            <div class="d-flex mt-auto">
                                <field name="priority" widget="priority" class="me-2"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_lead_list" model="ir.ui.view">
        <field name="name">edu.lead.list</field>
        <field name="model">edu.lead</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'lost'">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="class_applying_id"/>
                <field name="stage_id"/>
                <field name="source_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_edu_lead_form" model="ir.ui.view">
        <field name="name">edu.lead.form</field>
        <field name="model">edu.lead</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_contacted" string="Mark Contacted" type="object"
                            invisible="state != 'new'"/>
                    <button name="action_mark_qualified" string="Mark Qualified" type="object"
                            invisible="state != 'contacted'"/>
                    <button name="action_convert_to_applicant" string="Convert to Applicant"
                            type="object" class="oe_highlight"
                            invisible="state not in ('contacted', 'qualified')"/>
                    <button name="action_lost" string="Mark Lost" type="object"
                            invisible="state in ('converted', 'lost')"/>
                    <button name="action_restore" string="Restore" type="object"
                            invisible="state != 'lost'"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                        </group>
                        <group string="Admission Interest">
                            <field name="student_name"/>
                            <field name="student_dob"/>
                            <field name="class_applying_id"/>
                            <field name="academic_year_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tracking">
                            <field name="source_id"/>
                            <field name="medium_id"/>
                            <field name="campaign_id"/>
                            <field name="is_from_website"/>
                        </group>
                        <group string="Ownership">
                            <field name="user_id"/>
                            <field name="priority"/>
                            <field name="state"/>
                            <field name="lost_reason_id" invisible="state != 'lost'"/>
                            <field name="applicant_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Notes..."/>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="view_edu_lead_search" model="ir.ui.view">
        <field name="name">edu.lead.search</field>
        <field name="model">edu.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="class_applying_id"/>
                <filter name="my_leads" string="My Inquiries" domain="[('user_id', '=', uid)]"/>
                <filter name="from_website" string="From Website" domain="[('is_from_website', '=', True)]"/>
                <group>
                    <filter name="group_by_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_by_source" string="Source" context="{'group_by': 'source_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_lead" model="ir.actions.act_window">
        <field name="name">Admission Inquiries</field>
        <field name="res_model">edu.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_edu_lead_search"/>
        <field name="context">{'search_default_my_leads': 0}</field>
    </record>
</odoo>
