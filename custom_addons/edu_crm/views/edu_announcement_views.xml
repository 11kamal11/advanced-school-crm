<odoo>
    <!-- ── Search view ──────────────────────────────────────────── -->
    <record id="view_edu_announcement_search" model="ir.ui.view">
        <field name="name">edu.announcement.search</field>
        <field name="model">edu.announcement</field>
        <field name="arch" type="xml">
            <search string="Announcements">
                <field name="name"/>
                <filter string="Active"      name="active"   domain="[('active','=',True)]"/>
                <filter string="Archived"   name="archived" domain="[('active','=',False)]"/>
                <filter string="High Priority" name="urgent" domain="[('priority','=','high')]"/>
                <separator/>
                <filter string="All Students"  name="all"    domain="[('audience','=','all')]"/>
                <filter string="By Class"      name="class"  domain="[('audience','=','class')]"/>
                <filter string="Staff Only"    name="staff"  domain="[('audience','=','staff')]"/>
                <group>
                    <filter name="group_audience"  string="Audience"  context="{'group_by':'audience'}"/>
                    <filter name="group_priority"  string="Priority"  context="{'group_by':'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_edu_announcement_list" model="ir.ui.view">
        <field name="name">edu.announcement.list</field>
        <field name="model">edu.announcement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="audience"/>
                <field name="priority"/>
                <field name="publish_date"/>
                <field name="expiry_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_edu_announcement_form" model="ir.ui.view">
        <field name="name">edu.announcement.form</field>
        <field name="model">edu.announcement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="audience"/>
                            <field name="class_ids" widget="many2many_tags"
                                   invisible="audience != 'class'"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="publish_date"/>
                            <field name="expiry_date"/>
                            <field name="active"/>
                            <field name="is_portal_visible"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="action_edu_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">edu.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_announcement_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
