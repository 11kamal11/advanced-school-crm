<odoo>
    <record id="view_edu_announcement_list" model="ir.ui.view">
        <field name="name">edu.announcement.list</field>
        <field name="model">edu.announcement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="audience"/>
                <field name="priority"/>
                <field name="publish_date"/>
                <field name="expiry_date"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_edu_announcement_form" model="ir.ui.view">
        <field name="name">edu.announcement.form</field>
        <field name="model">edu.announcement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="audience"/>
                            <field name="class_ids" widget="many2many_tags"
                                   invisible="audience != 'class'"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="publish_date"/>
                            <field name="expiry_date"/>
                            <field name="is_active"/>
                            <field name="is_portal_visible"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="action_edu_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">edu.announcement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
